rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidPrompt(data) {
      return data.keys().hasAll([
        'title',
        'description',
        'content',
        'category',
        'targetModel',
        'collectionName',
        'tags',
        'isPinned',
        'usageCount',
        'ownerId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title',
        'description',
        'content',
        'category',
        'targetModel',
        'collectionName',
        'tags',
        'isPinned',
        'usageCount',
        'ownerId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.description is string && data.description.size() >= 0 && data.description.size() <= 500 &&
      data.content is string && data.content.size() >= 1 && data.content.size() <= 10000 &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
      data.category in ['Coding', 'Writing', 'Analysis', 'System', 'Research', 'Creative'] &&
      data.targetModel is string && data.targetModel.size() >= 1 && data.targetModel.size() <= 60 &&
      data.collectionName is string && data.collectionName.size() >= 1 && data.collectionName.size() <= 60 &&
      data.tags is list && data.tags.size() <= 8 &&
      (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() >= 1 && data.tags[0].size() <= 32)) &&
      data.isPinned is bool &&
      data.usageCount is int && data.usageCount >= 0 && data.usageCount <= 1000000 &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /prompts/{promptId} {
      allow get: if isSignedIn() && isValidId(promptId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(promptId) &&
        isValidPrompt(incoming()) &&
        incoming().usageCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(promptId) &&
        isValidPrompt(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'description',
            'content',
            'category',
            'targetModel',
            'collectionName',
            'tags',
            'isPinned',
            'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'isPinned',
            'updatedAt'
          ]) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'usageCount',
              'updatedAt'
            ]) &&
            incoming().usageCount == existing().usageCount + 1
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(promptId) &&
        existing().ownerId == request.auth.uid;
    }
  }
}
